# Vanguard Estates — server-side environment
# Copy to .env and fill in locally. NEVER expose these values to the client.

# Google Gemini API key (server only). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used by the Private Concierge
GEMINI_MODEL=gemini-2.5-flash

# API + production server port
PORT=8787

# Set only when behind a trusted reverse proxy (e.g. 1 on Render/Fly/Cloud Run)
TRUST_PROXY=0

# Comma-separated additional allowed origins for the API (production)
ALLOWED_ORIGIN=

# Where enquiry requests are persisted (never inside public/)
ENQUIRY_STORE_PATH=server/data/enquiries.jsonl
